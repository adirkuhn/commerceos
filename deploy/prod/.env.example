# Production configuration. Copy to .env next to docker-compose.yml, fill in,
# chmod 660. Never commit .env. Every setting of the repo-root .env.example
# applies here too (Postgres, JWT, S3, domains...); the lines below are what
# the production stack adds.

# Release running on this server. Managed by deploy.sh (deploy.sh 1.2.3
# rewrites it); set it by hand only for the very first start. Never a moving
# tag like "master".
COMMERCEOS_VERSION=1.0.0
# The release COMMERCEOS_VERSION replaced -- what `deploy.sh rollback` goes
# back to. Managed by deploy.sh.
# COMMERCEOS_PREVIOUS_VERSION=

# ---- Optional (default shown) ----
# Images are <prefix>-backend, <prefix>-frontend and <prefix>-storefront.
# COMMERCEOS_IMAGE_PREFIX=ghcr.io/adirkuhn/commerceos

# The admin frontend's VITE_* URLs are compiled into its image by CI (GitHub
# repository variables), not read from here -- except VITE_API_BASE_URL,
# which the storefront also uses as its public API URL unless
# STOREFRONT_API_PUBLIC_URL is set.
