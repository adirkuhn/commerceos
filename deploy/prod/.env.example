# Production configuration. Copy to .env NEXT TO docker-compose.yml and
# deploy.sh (compose reads .env from the compose file's own folder), fill in,
# chmod 660. Never commit .env. Placeholders only below -- generate real
# secrets, e.g. `openssl rand -base64 48`.

# ---- Release (managed by deploy.sh) ----
# Running release. deploy.sh 1.2.3 rewrites it; set it by hand only for the
# very first start. Never a moving tag like "master".
COMMERCEOS_VERSION=1.0.0
# The release COMMERCEOS_VERSION replaced -- what `deploy.sh rollback` goes
# back to. Written by deploy.sh.
# COMMERCEOS_PREVIOUS_VERSION=

# ---- Domains (routed by Traefik) ----
# API and storefront (/store) host.
API_DOMAIN=api.example.com
# Admin frontend host.
FRONTEND_DOMAIN=admin.example.com
API_PUBLIC_BASE_URL=https://api.example.com
FRONTEND_BASE_URL=https://admin.example.com
# Port the backend listens on inside its container. Must be 80: the Traefik
# label in docker-compose.yml sends API traffic to port 80.
HTTP_PORT=80

# ---- Postgres (container `postgres` on the external `database` network) ----
# Superuser: only the migrate service uses it, to run migrations.
POSTGRES_DB=commerceos
POSTGRES_USER=commerceos
POSTGRES_PASSWORD=change-me
# The role the app connects as (no superuser, no BYPASSRLS, so Row Level
# Security applies). migrate rotates its password to this value every start.
APP_DB_USER=commerceos_app
APP_DB_PASSWORD=change-me
# DB_DSN and NATS_URL are set by docker-compose.yml from the values above --
# anything set here for them is ignored.

# ---- Secrets ----
# Must equal lm2's JWT_SECRET: tokens lm2 issues are validated with it.
JWT_SECRET=change-me
# Encrypts stored integration credentials (Woo, Bol, MyParcel...). Changing it
# makes every stored credential unreadable -- set it once, back it up.
INTEGRATIONS_ENCRYPTION_SECRET=change-me

# ---- Product images (S3 / MinIO, on the external `minio` network) ----
STORAGE_DRIVER=s3
# host[:port], no scheme (S3_USE_SSL adds it).
S3_ENDPOINT=images.example.com
S3_ACCESS_KEY_ID=change-me
# Quote it if it contains special characters: S3_SECRET_ACCESS_KEY='...'
S3_SECRET_ACCESS_KEY=change-me
S3_BUCKET=product-media
S3_USE_SSL=true
# Public URL prefix images are served from (the bucket allows public reads).
S3_PUBLIC_BASE_URL=https://images.example.com/product-media

# ---- Admin frontend (read by its container at startup, served to browsers
# as /config.js -- public values only; restart the frontend to apply) ----
# Public API URL browsers use; the storefront also uses it unless
# STOREFRONT_API_PUBLIC_URL is set.
VITE_API_BASE_URL=https://api.example.com/api/v1
# lm2's app-login page and the callback path it returns to.
VITE_LM2_LOGIN_URL=https://lm2.example.com/app-login
VITE_LM2_CALLBACK_PATH=/auth/callback
# Where /store is served (default: the API's own origin).
# VITE_STOREFRONT_URL=https://api.example.com

# ---- Optional ----
# lm2's current POS license public key; when unset, /pos/* isn't mounted.
# LM2_LICENSE_PUBLIC_KEY_URL=https://lm2.example.com/api/v1/pos/public-keys/current
# STOREFRONT_API_PUBLIC_URL=https://api.example.com/api/v1
# Origin shoppers reach /store on (default https://API_DOMAIN).
# STOREFRONT_PUBLIC_URL=https://api.example.com
# Images are <prefix>-backend, <prefix>-frontend, <prefix>-storefront.
# COMMERCEOS_IMAGE_PREFIX=ghcr.io/adirkuhn/commerceos
