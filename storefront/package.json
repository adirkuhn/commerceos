{
  "name": "commerceos-storefront",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node server/main.ts",
    "build": "tsc && vite build --outDir dist/client && vite build --ssr src/runtime/entry-server.tsx --outDir dist/server && node scripts/check-budget.ts",
    "start": "NODE_ENV=production node server/main.ts",
    "test": "vitest",
    "test:e2e": "playwright test",
    "i18n:extract": "i18next --config i18next-parser.config.js",
    "i18n:check": "node scripts/i18n.ts check",
    "i18n:add": "node scripts/i18n.ts add"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "i18next": "^26.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.15",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@playwright/test": "1.48.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "grapesjs": "^0.22.4",
    "i18next-parser": "^9.0.2",
    "jsdom": "^24.1.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vitest": "^2.0.4"
  }
}
