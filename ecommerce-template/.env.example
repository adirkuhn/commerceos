# Every API_MODE=mock call runs entirely in-memory against src/config/demoData.ts
# -- no backend, no env vars required for local dev out of the box.
VITE_API_MODE=mock

# Once a real backend exists, point these at it and flip API_MODE to "api".
# The repository swap (Mock*Repository -> Api*Repository) is the only code
# change needed -- see src/repositories/index.ts.
VITE_API_BASE_URL=https://api.example.com/api/v1
VITE_API_KEY=

# Simulated network latency for mock repositories, in milliseconds. Keeps
# loading/skeleton states visibly real during development instead of
# resolving instantly.
VITE_MOCK_LATENCY_MS=350
