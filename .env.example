POSTGRES_DB=commerceos
POSTGRES_USER=commerceos
POSTGRES_PASSWORD=commerceos
# Dedicated non-superuser, non-BYPASSRLS role that backend/relay/scheduler
# actually connect as (POSTGRES_USER above is a Postgres superuser -- always
# bypasses Row Level Security, so it must never be used for live traffic).
# The migrate service creates this role and rotates its password to this
# value on every startup; see migrations/020_app_role_and_force_rls.sql.
APP_DB_USER=commerceos_app
APP_DB_PASSWORD=change-me-in-production

# Backend
DB_DSN=host=localhost user=commerceos_app password=change-me-in-production dbname=commerceos port=5432 sslmode=disable
NATS_URL=nats://localhost:4222
HTTP_PORT=8080
JWT_SECRET=change-me-in-production
# Must be a single-level subdomain under dev.localhost (e.g. api-commerceos, not
# api.commerceos) — the local mkcert wildcard cert (*.dev.localhost) only covers
# one label deep; a nested subdomain fails TLS with ERR_CERT_COMMON_NAME_INVALID.
API_DOMAIN=api-commerceos.dev.localhost
# Encrypts stored third-party credentials at rest (e.g. WooCommerce consumer secrets)
INTEGRATIONS_ENCRYPTION_SECRET=change-me-in-production
# This API's own publicly reachable base URL — used to build the callback_url
# WooCommerce's Application Authentication flow POSTs back to
API_PUBLIC_BASE_URL=http://localhost:8080
# CommerceOS frontend's base URL — used to build the return_url the merchant's
# browser lands back on after approving the WooCommerce connection
FRONTEND_BASE_URL=http://localhost:3000
# lm2's endpoint for fetching its current RSA signing public key — used to
# verify a POS desktop's license on /pos/* requests (see
# infrastructure/lm2license, middleware.POSLicense). Optional: when unset,
# /pos/* routes aren't mounted at all. Confirm the actual path/response
# shape against lm2 before relying on this — see
# infrastructure/lm2license/public_key_fetcher.go's doc comment.
# LM2_LICENSE_PUBLIC_KEY_URL=https://lm2.example.com/api/public-key
# Outbound-email SMTP relay, used to send storefront magic-link login
# emails (see domain/email, infrastructure/email). Optional: when
# SMTP_HOST is unset, the storefront auth routes aren't mounted at all.
# Any STARTTLS-capable relay works (Gmail/Workspace, Mailgun/SES's SMTP
# endpoint, a self-hosted Postfix) — no vendor-specific SDK.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=changeme
# SMTP_FROM="CommerceOS <no-reply@example.com>"
# Product image storage driver: "local" (filesystem) or "s3" (MinIO / any
# S3-compatible store). Optional — defaults to "local".
STORAGE_DRIVER=local
# Local filesystem directory uploaded product images are saved to, served
# back out at API_PUBLIC_BASE_URL + /api/v1/uploads. Only used when
# STORAGE_DRIVER=local. Optional — defaults to ./uploads if unset.
MEDIA_UPLOAD_DIR=./uploads
# S3/MinIO config — required when STORAGE_DRIVER=s3 (docker-compose defaults
# to s3; the createbuckets service also uses these to create/prep the bucket
# on startup). Points at an externally-run MinIO/S3 — not managed by this
# compose file. host:port only, no scheme (the client adds it via S3_USE_SSL).
S3_ENDPOINT=minio.example.com:9000
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
S3_BUCKET=product-media
S3_USE_SSL=false
# Publicly reachable URL prefix product images are served from — the bucket
# must allow public reads. E.g. a domain pointed at MinIO, or a CDN in front.
S3_PUBLIC_BASE_URL=https://minio.example.com:9000/product-media

# Frontend
FRONTEND_DOMAIN=commerceos.dev.localhost
VITE_API_BASE_URL=http://localhost:8080/api/v1
# lm2 external auth server — used by login page redirect. Must point at
# lm2's app-login page (not its old /login), and JWT_SECRET above must match
# lm2's own JWT_SECRET so tokens it issues validate here.
VITE_LM2_LOGIN_URL=http://localhost:9000/app-login
VITE_LM2_CALLBACK_PATH=/auth/callback

# Storefront (storefront-frontend/) — one deployment serves every
# tenant's every internal sales channel (resolved at runtime from the URL,
# not baked in — see docker-compose.yml's storefront service). Must also
# be a single-level dev.localhost subdomain locally, same reason as
# API_DOMAIN above.
STOREFRONT_DOMAIN=shop-commerceos.dev.localhost
# Base URL the admin app builds each internal sales channel's own
# "Visit store" link from (.../store/<channel id>). Should match
# STOREFRONT_DOMAIN above, with scheme.
VITE_STOREFRONT_URL=https://shop-commerceos.dev.localhost
